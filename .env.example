# Free local inference is the default. No API key or billing is required.
DRC_PROVIDER=ollama
OLLAMA_MODEL=qwen3:8b

# Optional paid provider, only used if explicitly selected with --provider openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17

# Optional Gemini provider, only used if explicitly selected with --provider gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
